    {
      "id": "open-articles",
      "courseLessonId": "open-articles",
      "language": "en",
      "level": "预备",
      "auxiliary": true,
      "order": 2,
      "title": "冠词：a、an、the 与不填",
      "subtitle": "公开双语语法内容 · 审校改编小样",
      "minutes": 12,
      "objectives": [
        "按读音选择 a / an",
        "判断是否特指",
        "识别常见零冠词搭配"
      ],
      "sections": [
        {
          "id": "open-articles-sound",
          "title": "a / an 看发音，不看字母",
          "explanation": "首次引入非特指的单数可数名词时常用 a / an。元音音素开头用 an，辅音音素开头用 a：an hour、an honest girl，但 a university。",
          "examples": [
            {
              "sentence": "A classmate lent me an umbrella.",
              "translation": "一位同学借给我一把雨伞。"
            },
            {
              "sentence": "I waited for an hour.",
              "translation": "我等了一个小时。"
            }
          ]
        },
        {
          "id": "open-articles-specific",
          "title": "特指与常见固定用法",
          "explanation": "再次提到或双方知道具体对象时常用 the。泛指三餐、球类、语言，以及 by bus 等交通方式通常不加冠词；特指时用法可能变化，不能死记成永远不加。play the guitar 和 play football 是本课采用的常见标准表达。",
          "examples": [
            {
              "sentence": "I got a package; the package was heavy.",
              "translation": "我收到了一个包裹；那个包裹很重。"
            },
            {
              "sentence": "They play basketball after class.",
              "translation": "他们课后打篮球。"
            }
          ],
          "tip": "未导入原稿有歧义的 music class 填空；也不把 by the bus 直接解释成“乘那辆车”，这种意思通常用 on / take the bus。"
        }
      ],
