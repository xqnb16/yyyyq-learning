    {
      "id": "open-pronouns",
      "courseLessonId": "open-pronouns",
      "language": "en",
      "level": "预备",
      "auxiliary": true,
      "order": 3,
      "title": "代词：谁在做，属于谁",
      "subtitle": "公开双语语法内容 · 审校改编小样",
      "minutes": 12,
      "objectives": [
        "区分主格与宾格",
        "区分 my 与 mine",
        "使用反身代词与邀请中的 some"
      ],
      "sections": [
        {
          "id": "open-pronouns-role",
          "title": "先判断代词的句法角色",
          "explanation": "主语通常用 I / we / they，动词或介词的宾语用 me / us / them。不要只靠“在动词前还是后”判断：问句、倒装或前置宾语会改变位置，角色才是关键。并列主语 My roommate and I work ... 用 I。",
          "examples": [
            {
              "sentence": "We often study in the library.",
              "translation": "我们常在图书馆学习。"
            },
            {
              "sentence": "The tutor helped us a lot.",
              "translation": "导师帮了我们很多。"
            }
          ]
        },
        {
          "id": "open-pronouns-ownership",
          "title": "my 带名词，mine 可以独立用",
          "explanation": "my book 中 my 限定名词；This book is mine 中 mine 独立表示“我的那本”。by myself 表独自，enjoy ourselves 表玩得开心；She made the cake herself 强调亲手做，但不必意味着没人帮忙。邀请或提供某物的问句也常用 some。",
          "examples": [
            {
              "sentence": "This is my dorm; that is yours.",
              "translation": "这是我的宿舍；那是你的。"
            },
            {
              "sentence": "Help yourself to some fruit.",
              "translation": "请随便吃些水果。"
            }
          ],
          "tip": "neither of 后口语中也可见复数动词，不能把单数形式说成所有语境唯一正确；本课不导入这一歧义选项。"
        }
      ],
