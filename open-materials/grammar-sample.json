    {
      "id": "open-prepositions",
      "courseLessonId": "open-prepositions",
      "language": "en",
      "level": "预备",
      "auxiliary": true,
      "order": 4,
      "title": "介词：时间、地点与固定搭配",
      "subtitle": "公开双语语法内容 · 审校改编小样",
      "minutes": 12,
      "objectives": [
        "区分 at / on / in 的常见时间用法",
        "表达地点与方位",
        "区分介词 to 与不定式 to"
      ],
      "sections": [
        {
          "id": "open-prepositions-time",
          "title": "时刻、具体日子和较长时段",
          "explanation": "钟点通常用 at，具体日期和星期通常用 on，月份、年份、季节通常用 in。next Monday、this summer、every day 等表达通常不用再加时间介词；不要把规则机械套在所有时间短语前。",
          "examples": [
            {
              "sentence": "The class starts at eight. We rest on Sunday.",
              "translation": "课程八点开始，我们周日休息。"
            },
            {
              "sentence": "We have finals in July.",
              "translation": "我们七月有期末考试。"
            }
          ]
        },
        {
          "id": "open-prepositions-place",
          "title": "地点与固定搭配要看语境",
          "explanation": "at 常把地点看作活动点，on 常表示表面，in 常表示内部或地区。还要整体记 good at、afraid of、interested in 和 look forward to doing。between 可以表达多个清楚区分的对象之间的关系，不是只要超过两者就必须改 among。",
          "examples": [
            {
              "sentence": "I waited at the bus stop. My keys are on the desk.",
              "translation": "我在公交站等候，钥匙在桌上。"
            },
            {
              "sentence": "I look forward to hearing from you.",
              "translation": "我期待收到你的来信。"
            }
          ],
          "tip": "look forward to 的 to 是介词，所以后面的动作表达用 hearing，不是 hear。"
        }
      ],
      "practiceQuestionIds": [
