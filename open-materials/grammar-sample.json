  "lessons": [
    {
      "id": "open-nouns",
      "courseLessonId": "open-nouns",
      "language": "en",
      "level": "预备",
      "auxiliary": true,
      "order": 1,
      "title": "名词：能不能数，属于谁",
      "subtitle": "公开双语语法内容 · 审校改编小样",
      "minutes": 12,
      "objectives": [
        "区分可数与不可数",
        "使用量词和不规则复数",
        "辨认所有格"
      ],
      "sections": [
        {
          "id": "open-nouns-count",
          "title": "先判断能否计数",
          "explanation": "可数名词常配 many / few；不可数名词常配 much / little。homework、luggage、advice 在这些常见义项中不可数。用 a piece of advice、two cups of milk tea 时，计数的是 piece 或 cup。",
          "examples": [
            {
              "sentence": "I have many friends but little free time.",
              "translation": "我有很多朋友，但空闲时间很少。"
            },
            {
              "sentence": "Let me give you a piece of advice.",
              "translation": "让我给你一条建议。"
            }
          ]
        },
        {
          "id": "open-nouns-plural",
          "title": "复数与所属关系",
          "explanation": "规则复数看词尾，不规则复数逐词记忆，如 child → children、tooth → teeth。部分 f / fe 结尾名词变 -ves，但不是全部，例如 roof → roofs。所有格可以表示人、组织、时间等所属关系；不能把无生命名词一律禁止使用 ’s。",
          "examples": [
            {
              "sentence": "Brush your teeth twice a day.",
              "translation": "每天刷两次牙。"
            },
            {
              "sentence": "Is this Lisa’s lunch box?",
              "translation": "这是丽莎的饭盒吗？"
            }
          ],
          "tip": "已修正原课件中把所有格和 f / fe 复数写成绝对规律的简化说法。"
        }
      ],
      "practiceQuestionIds": [
        "open-nouns-q1",
        "open-nouns-q2",
        "open-nouns-q3",
        "open-nouns-q4",
        "open-nouns-q5",
        "open-nouns-q6"
      ],
      "sourceInfo": {
